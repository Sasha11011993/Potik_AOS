      "parameters": {
        "jsCode": "const safeItems = (nodeName) => {\n  try { return $(nodeName).all(); } catch { return []; }\n};\nconst sumField = (nodeName, fieldName) =>\n  safeItems(nodeName).reduce((sum, item) => sum + Number(item.json[fieldName] ?? 0), 0);\n\nconst run = $('Prepare demand run start').first().json;\nconst inputItems = safeItems('Read opportunities').length;\nconst validItems = safeItems('Filter valid opportunities').length;\nconst projectItems = safeItems('Keep client projects').length;\nconst intentCalls = safeItems('Normalize opportunity intent usage').length;\nconst analysisCalls = safeItems('Normalize demand signals usage').length;\nconst inputTokens = sumField('Normalize opportunity intent usage', 'intent_input_tokens') + sumField('Normalize demand signals usage', 'analysis_input_tokens');\nconst cachedInputTokens = sumField('Normalize opportunity intent usage', 'intent_cached_input_tokens') + sumField('Normalize demand signals usage', 'analysis_cached_input_tokens');\nconst outputTokens = sumField('Normalize opportunity intent usage', 'intent_output_tokens') + sumField('Normalize demand signals usage', 'analysis_output_tokens');\nconst totalTokens = sumField('Normalize opportunity intent usage', 'intent_total_tokens') + sumField('Normalize demand signals usage', 'analysis_total_tokens');\n\nconst INPUT_RATE_PER_MILLION = 0.75;\nconst CACHED_INPUT_RATE_PER_MILLION = 0.075;\nconst OUTPUT_RATE_PER_MILLION = 4.5;\nconst estimatedCostUsd = Number((\n  (Math.max(0, inputTokens - cachedInputTokens) / 1_000_000) * INPUT_RATE_PER_MILLION +\n  (cachedInputTokens / 1_000_000) * CACHED_INPUT_RATE_PER_MILLION +\n  (outputTokens / 1_000_000) * OUTPUT_RATE_PER_MILLION\n).toFixed(8));\nconst finishedAt = $now.toISO();\nconst durationSeconds = Math.max(0, Math.round($now.diff(DateTime.fromISO(run.started_at), 'seconds').seconds));\n\nreturn [{ json: {\n  'run_id (ID запуску)': run.run_id,\n  'n8n_execution_id (ID виконання n8n)': run.n8n_execution_id,\n  'workflow_name (Назва workflow)': run.workflow_name,\n  'workflow_category (Категорія workflow)': run.workflow_category,\n  'trigger_type (Тип запуску)': run.trigger_type,\n  'started_at (Час початку)': run.started_at,\n  'finished_at (Час завершення)': finishedAt,\n  'duration_seconds (Тривалість, сек)': durationSeconds,\n  'run_status (Статус запуску)': 'success',\n  'items_input (Вхідних записів)': inputItems,\n  'items_processed (Оброблено записів)': projectItems,\n  'items_created (Створено записів)': 0,\n  'items_updated (Оновлено записів)': projectItems,\n  'items_skipped (Пропущено записів)': Math.max(0, validItems - projectItems),\n  'items_failed (Помилок записів)': 0,\n  'ai_calls (AI-викликів)': intentCalls + analysisCalls,\n  'model_name (AI-модель)': 'gpt-5.4-mini',\n  'input_tokens (Вхідні токени)': inputTokens,\n  'output_tokens (Вихідні токени)': outputTokens,\n  'total_tokens (Усього токенів)': totalTokens,\n  'estimated_cost_usd (Орієнтовна вартість, USD)': estimatedCostUsd,\n  'error_message (Повідомлення про помилку)': '',\n  'run_metadata (Додаткові дані JSON)': JSON.stringify({\n    intent_calls: intentCalls, demand_analysis_calls: analysisCalls,\n    cached_input_tokens: cachedInputTokens,\n    pricing_usd_per_million: { input: INPUT_RATE_PER_MILLION, cached_input: CACHED_INPUT_RATE_PER_MILLION, output: OUTPUT_RATE_PER_MILLION },\n    method: 'OpenAI Responses API actual usage',\n  }),\n}}];"
